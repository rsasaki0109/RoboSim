<?xml version="1.0"?>
<robot name="two_link_arm">
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.4 0.2 0.1"/></geometry>
      <material name="material"><color rgba="0.8 0.2 0.1 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.4 0.2 0.1"/></geometry>
    </collision>
  </link>
  <joint name="shoulder" type="revolute">
    <parent link="base_link"/>
    <child link="upper_link"/>
    <origin xyz="0 0.05 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14" upper="3.14" effort="0" velocity="0"/>
  </joint>
  <link name="upper_link">
    <visual>
      <origin xyz="0 0.25 0" rpy="0 0 0"/>
      <geometry><cylinder radius="0.05" length="0.5"/></geometry>
    </visual>
    <collision>
      <origin xyz="0 0.25 0" rpy="0 0 0"/>
      <geometry><cylinder radius="0.05" length="0.5"/></geometry>
    </collision>
  </link>
  <joint name="elbow" type="revolute">
    <parent link="upper_link"/>
    <child link="tip_link"/>
    <origin xyz="0 0.5 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.57" upper="1.57" effort="0" velocity="0"/>
  </joint>
  <link name="tip_link">
    <visual>
      <origin xyz="0 0.5 0" rpy="0 0 0"/>
      <geometry><sphere radius="0.03"/></geometry>
    </visual>
    <collision>
      <origin xyz="0 0.5 0" rpy="0 0 0"/>
      <geometry><sphere radius="0.03"/></geometry>
    </collision>
  </link>
</robot>
