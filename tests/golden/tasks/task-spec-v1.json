        "name": "base_position_m",
        "dtype": "f64",
        "shape": [
          2
        ],
        "unit": "m",
        "layout": "row_major",
        "bounds": null
      },
      {
        "name": "base_yaw_rad",
        "dtype": "f64",
        "shape": [],
        "unit": "rad",
        "layout": "row_major",
        "bounds": null
      },
      {
        "name": "target_position_m",
        "dtype": "f64",
        "shape": [
          2
        ],
        "unit": "m",
        "layout": "row_major",
        "bounds": null
      }
    ]
  },
  "action": {
    "tensors": [
      {
        "name": "wheel_velocity_rad_s",
        "dtype": "f64",
        "shape": [
          2
        ],
        "unit": "rad/s",
