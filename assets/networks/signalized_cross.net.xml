<?xml version="1.0" encoding="UTF-8"?>
<!-- Signalized four-way SUMO road network fixture: lanes identical to
     minimal_cross.net.xml, with explicit connections and one fixed-time
     tlLogic signal program. Link indexes 0-3 are the northbound/side-street
     movements (green first), 4-5 the eastbound movements (red first), and 6
     the side-street straight. -->
<net version="1.16" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/net_file.xsd">
    <location netOffset="0.00,0.00" origBoundary="0.00,0.00,400.00,400.00" convBoundary="0.00,0.00,400.00,400.00" origProj="+proj=utm +zone=50 +ellps=WGS84 +datum=WGS84 +units=m +no_defs" projParameter="+proj=utm +zone=50 +ellps=WGS84 +datum=WGS84 +units=m +no_defs"/>
    <edge id="northbound" from="north" to="center">
        <lane id="northbound_0" index="0" speed="13.89" length="100.00" shape="200.00,300.00 200.00,200.00" width="3.50" allow="private passenger"/>
        <lane id="northbound_1" index="1" speed="13.89" length="100.00" shape="203.50,300.00 203.50,200.00" width="3.50" allow="private passenger"/>
    </edge>
    <edge id="southbound" from="center" to="south">
        <lane id="southbound_0" index="0" speed="13.89" length="100.00" shape="196.50,200.00 196.50,100.00" width="3.50" allow="private passenger"/>
    </edge>
    <edge id="eastbound" from="east" to="center">
        <lane id="eastbound_0" index="0" speed="13.89" length="100.00" shape="300.00,196.50 200.00,196.50" width="3.50" allow="private passenger"/>
    </edge>
    <edge id="westbound" from="center" to="west">
        <lane id="westbound_0" index="0" speed="13.89" length="100.00" shape="200.00,203.50 100.00,203.50" width="3.50" allow="private passenger"/>
    </edge>
    <edge id="pedestrian_path" from="northwest" to="center">
        <lane id="pedestrian_path_0" index="0" speed="1.39" length="150.00" shape="150.00,350.00 200.00,200.00" width="2.00" allow="pedestrian"/>
    </edge>
    <edge id="bike_path" from="bikenorth" to="center">
        <lane id="bike_path_0" index="0" speed="5.56" length="90.00" shape="207.00,290.00 203.50,200.00" width="1.50" allow="bicycle"/>
    </edge>
    <edge id="side_street" from="west" to="center">
        <lane id="side_street_0" index="0" speed="8.33" length="60.00" shape="100.00,200.00 200.00,200.00" width="3.00" allow="private passenger"/>
    </edge>
    <connection from="northbound" to="southbound" fromLane="0" toLane="0" dir="s" state="M" tl="0" linkIndex="0"/>
    <connection from="northbound" to="southbound" fromLane="1" toLane="0" dir="s" state="M" tl="0" linkIndex="1"/>
    <connection from="northbound" to="westbound" fromLane="0" toLane="0" dir="r" state="M" tl="0" linkIndex="2"/>
    <connection from="northbound" to="westbound" fromLane="1" toLane="0" dir="r" state="M" tl="0" linkIndex="3"/>
    <connection from="eastbound" to="southbound" fromLane="0" toLane="0" dir="l" state="M" tl="0" linkIndex="4"/>
    <connection from="eastbound" to="westbound" fromLane="0" toLane="0" dir="s" state="M" tl="0" linkIndex="5"/>
    <connection from="side_street" to="southbound" fromLane="0" toLane="0" dir="l" state="M" tl="0" linkIndex="6"/>
    <tlLogic id="0" type="static" programID="0" offset="0">
        <phase duration="20" state="GGGGrrG"/>
        <phase duration="15" state="rrrrGGr"/>
    </tlLogic>
</net>
