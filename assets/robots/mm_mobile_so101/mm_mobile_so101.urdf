<?xml version="1.0"?>
<robot name="mm_mobile_so101">
    <!-- mm_mobile diff-drive base + SO101 6-DoF arm (generated). -->
    <!-- SO101 inertial kept for multibody; arm mounts directly on base_link. -->
<link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.5 0.3 0.4"/>
      </geometry>
      <material name="hero_blue">
        <color rgba="0.16 0.38 0.72 1.0"/>
      </material>
    </visual>
    <!-- Collision box is shorter than the visual chassis and shifted down: the
         shoulder pivot sits at +0.15 and the upper-arm collision box (0.08 tall)
         reaches down to +0.11, so a full-height chassis collider interpenetrates
         the arm and contact impulses lock the shoulder joint solid. -->
    <collision>
      <origin xyz="0 0 -0.05" rpy="0 0 0"/>
      <geometry>
        <box size="0.5 0.2 0.4"/>
      </geometry>
    </collision>
  </link>
<link name="left_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <material name="wheel_black">
        <color rgba="0.08 0.08 0.08 1.0"/>
      </material>
      <geometry>
        <cylinder radius="0.1" length="0.05"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.1" length="0.05"/>
      </geometry>
    </collision>
  </link>
<link name="right_wheel">
