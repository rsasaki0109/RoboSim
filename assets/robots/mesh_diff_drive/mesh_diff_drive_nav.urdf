<?xml version="1.0"?>
<!-- mesh_diff_drive_nav: sensor mast + stereo bar, authored for RNE.
     RNE's URDF importer (a) only reads INLINE <material><color> (named
     references fall back to gray), and (b) maps base_link visuals by identity,
     so origins below are in RNE Y-up metres (x forward, y up, z lateral with
     left = -Z) to match the navigation calibration (lenses at z=+/-0.03,
     optical centers at x=0.20, y=0.35 in base frame). Wheel links are kept
     without visuals for spawn compatibility; wheels are static visuals here
     (joint visual placement is unreliable in the importer). Physics and
     collision are unchanged from mesh_diff_drive. -->
<robot name="mesh_diff_drive_nav">
  <link name="base_link">
    <!-- Box primitive instead of the STL: RNE's importer mis-scales mesh
         visuals, while primitives render at the authored size. -->
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.50 0.30 0.40"/>
      </geometry>
      <material>
        <color rgba="0.20 0.35 0.75 1.0"/>
      </material>
    </visual>
    <visual>
      <origin xyz="0.20 0.25 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.03 0.20 0.03"/>
      </geometry>
      <material>
        <color rgba="0.15 0.15 0.17 1.0"/>
      </material>
    </visual>
    <visual>
      <origin xyz="0.20 0.35 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.05 0.04 0.17"/>
      </geometry>
      <material>
        <color rgba="0.15 0.15 0.17 1.0"/>
      </material>
    </visual>
    <visual>
      <origin xyz="0.20 0.35 -0.03" rpy="0 0 0"/>
      <geometry>
        <box size="0.04 0.05 0.06"/>
      </geometry>
      <material>
        <color rgba="0.05 0.05 0.06 1.0"/>
      </material>
    </visual>
    <visual>
      <origin xyz="0.20 0.35 0.03" rpy="0 0 0"/>
      <geometry>
        <box size="0.04 0.05 0.06"/>
      </geometry>
      <material>
        <color rgba="0.05 0.05 0.06 1.0"/>
      </material>
    </visual>
    <visual>
      <origin xyz="0.2225 0.35 -0.03" rpy="0 0 0"/>
      <geometry>
        <box size="0.005 0.03 0.04"/>
      </geometry>
      <material>
        <color rgba="0.05 0.10 0.30 1.0"/>
      </material>
    </visual>
    <visual>
      <origin xyz="0.2225 0.35 0.03" rpy="0 0 0"/>
      <geometry>
        <box size="0.005 0.03 0.04"/>
      </geometry>
      <material>
        <color rgba="0.05 0.10 0.30 1.0"/>
      </material>
    </visual>
    <visual>
      <origin xyz="0 -0.15 -0.225" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.10" length="0.05"/>
      </geometry>
      <material>
        <color rgba="0.15 0.15 0.17 1.0"/>
      </material>
    </visual>
    <visual>
      <origin xyz="0 -0.15 0.225" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.10" length="0.05"/>
      </geometry>
      <material>
        <color rgba="0.15 0.15 0.17 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.5 0.3 0.4"/>
      </geometry>
    </collision>
  </link>

  <link name="left_wheel">
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.1" length="0.05"/>
      </geometry>
    </collision>
  </link>

  <link name="right_wheel">
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.1" length="0.05"/>
      </geometry>
    </collision>
  </link>

  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_wheel"/>
    <origin xyz="0 0.225 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_wheel"/>
    <origin xyz="0 -0.225 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>
</robot>
