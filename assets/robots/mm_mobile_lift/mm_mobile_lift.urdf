<?xml version="1.0"?>
<!-- Lift-capable mobile manipulator combining the shipped differential base and
     vertical-carriage/top-down-claw mechanisms. -->
<robot name="mm_mobile_lift">
  <link name="base_link">
    <visual><geometry><box size="0.5 0.3 0.4"/></geometry><material name="hero_blue"><color rgba="0.16 0.38 0.72 1.0"/></material></visual>
    <visual><origin xyz="0 0.45 0" rpy="0 0 0"/><geometry><box size="0.12 0.7 0.12"/></geometry><material name="lift_column"><color rgba="0.20 0.23 0.28 1.0"/></material></visual>
    <collision><origin xyz="0 0 -0.05" rpy="0 0 0"/><geometry><box size="0.5 0.2 0.4"/></geometry></collision>
  </link>
  <link name="left_wheel">
    <visual><geometry><cylinder radius="0.1" length="0.05"/></geometry><material name="wheel_black"><color rgba="0.08 0.08 0.08 1.0"/></material></visual>
  </link>
  <link name="right_wheel">
    <visual><geometry><cylinder radius="0.1" length="0.05"/></geometry><material name="wheel_black"><color rgba="0.08 0.08 0.08 1.0"/></material></visual>
  </link>
  <link name="torso_link">
    <visual><geometry><box size="0.14 0.14 0.14"/></geometry><material name="lift_carriage"><color rgba="0.72 0.76 0.82 1.0"/></material></visual>
    <!-- The carriage link starts inside the protected chassis. Its compact mass
         collider is offset into the hollow lift column so adjacent-link contact
         cannot lock the prismatic joint at zero travel. -->
    <collision><origin xyz="0 0.30 0" rpy="0 0 0"/><geometry><box size="0.08 0.08 0.08"/></geometry></collision>
  </link>
  <link name="upper_arm_link">
    <visual><origin xyz="0.25 0 0" rpy="0 0 0"/><geometry><box size="0.5 0.07 0.07"/></geometry><material name="hero_arm"><color rgba="0.90 0.42 0.12 1.0"/></material></visual>
    <collision><origin xyz="0.24 0 0" rpy="0 0 0"/><geometry><box size="0.42 0.035 0.035"/></geometry></collision>
  </link>
  <link name="forearm_link">
    <visual><origin xyz="0.2 0 0" rpy="0 0 0"/><geometry><box size="0.4 0.055 0.055"/></geometry><material name="hero_arm"><color rgba="0.90 0.42 0.12 1.0"/></material></visual>
    <!-- A compact dynamics collider keeps the link in the articulation while
         avoiding false self-contact with its adjacent upper-arm collider. -->
    <collision><origin xyz="0.24 0 0" rpy="0 0 0"/><geometry><box size="0.28 0.04 0.04"/></geometry></collision>
  </link>
  <link name="wrist_link">
    <inertial><mass value="0.10"/></inertial>
    <visual><geometry><cylinder radius="0.035" length="0.04"/></geometry><material name="hero_shell"><color rgba="0.72 0.76 0.82 1.0"/></material></visual>
    <collision><geometry><box size="0.04 0.04 0.04"/></geometry></collision>
  </link>
  <link name="gripper_base_link">
    <visual><geometry><box size="0.06 0.04 0.12"/></geometry><material name="hero_shell"><color rgba="0.72 0.76 0.82 1.0"/></material></visual>
    <!-- Keep the collider inside the two finger hinges. A full visual-width
         collider overlaps both adjacent finger links and continuously torques
         the whole arm away from its commanded pose. -->
    <collision><geometry><box size="0.02 0.02 0.01"/></geometry></collision>
  </link>
  <link name="left_finger_link">
    <inertial><mass value="0.05"/></inertial>
    <!-- Short pads stay above the pickup-table top while spanning the cube. -->
    <visual><origin xyz="0 -0.14 0" rpy="0 0 0"/><geometry><box size="0.10 0.07 0.02"/></geometry><material name="hero_gripper"><color rgba="0.10 0.12 0.15 1.0"/></material></visual>
    <collision><origin xyz="0 -0.14 0" rpy="0 0 0"/><geometry><box size="0.12 0.07 0.02"/></geometry></collision>
  </link>
  <link name="right_finger_link">
    <inertial><mass value="0.05"/></inertial>
    <!-- Short pads stay above the pickup-table top while spanning the cube. -->
    <visual><origin xyz="0 -0.14 0" rpy="0 0 0"/><geometry><box size="0.10 0.07 0.02"/></geometry><material name="hero_gripper"><color rgba="0.10 0.12 0.15 1.0"/></material></visual>
    <collision><origin xyz="0 -0.14 0" rpy="0 0 0"/><geometry><box size="0.12 0.07 0.02"/></geometry></collision>
  </link>

  <joint name="left_wheel_joint" type="continuous"><parent link="base_link"/><child link="left_wheel"/><origin xyz="0 -0.15 0.225" rpy="0 0 0"/><axis xyz="0 0 1"/></joint>
  <joint name="right_wheel_joint" type="continuous"><parent link="base_link"/><child link="right_wheel"/><origin xyz="0 -0.15 -0.225" rpy="0 0 0"/><axis xyz="0 0 1"/></joint>
  <joint name="lift_joint" type="prismatic"><parent link="base_link"/><child link="torso_link"/><origin xyz="0.15 0 0" rpy="0 0 0"/><axis xyz="0 1 0"/></joint>
  <joint name="shoulder_joint" type="revolute"><parent link="torso_link"/><child link="upper_arm_link"/><origin xyz="0.16 0 0" rpy="0 0 0"/><axis xyz="0 1 0"/></joint>
  <joint name="elbow_joint" type="revolute"><parent link="upper_arm_link"/><child link="forearm_link"/><origin xyz="0.5 0 0" rpy="0 0 0"/><axis xyz="0 1 0"/></joint>
  <joint name="wrist_yaw_joint" type="revolute">
    <parent link="forearm_link"/><child link="wrist_link"/><origin xyz="0.4 0 0" rpy="0 0 0"/><axis xyz="0 1 0"/>
    <limit lower="-3.141592653589793" upper="3.141592653589793" effort="20.0" velocity="3.0"/>
  </joint>
  <joint name="gripper_base_joint" type="fixed"><parent link="wrist_link"/><child link="gripper_base_link"/><origin xyz="0 0 0" rpy="0 0 0"/></joint>
  <joint name="left_finger_joint" type="prismatic">
    <parent link="gripper_base_link"/><child link="left_finger_link"/>
    <origin xyz="0 -0.02 -0.065" rpy="0 0 0"/><axis xyz="0 0 -1"/>
    <limit lower="-0.055" upper="0.0" effort="10.0" velocity="0.10"/>
  </joint>
  <joint name="right_finger_joint" type="prismatic">
    <parent link="gripper_base_link"/><child link="right_finger_link"/>
    <origin xyz="0 -0.02 0.065" rpy="0 0 0"/><axis xyz="0 0 -1"/>
    <limit lower="0.0" upper="0.055" effort="10.0" velocity="0.10"/>
  </joint>
</robot>
