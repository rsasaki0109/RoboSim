<?xml version="1.0" encoding="utf-8"?>
<!-- A 0.96 m x 0.90 m swing door leaf on a vertical hinge (URDF z up). Closed at
     0 rad against the stop (the joint's lower limit); positive angles open it
     toward +x. A round knob on a spindle through the leaf turns +-1.2 rad; the
     latch it retracts is modelled by the simulation that uses the door.
     Leaf: 6 kg, 3 cm thick; hinge damping 1 N m s/rad and friction
     0.2 N m, so a pushed door keeps swinging for a while as a real one does. -->
<robot name="swing_door">
  <link name="door_frame">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/>
    </inertial>
  </link>
  <link name="door_leaf">
    <inertial>
      <origin xyz="0 -0.49 0.47" rpy="0 0 0"/>
      <mass value="6.0"/>
      <!-- Box 0.03 x 0.96 x 0.90 about its centre. -->
      <inertia ixx="0.8658" ixy="0" ixz="0" iyy="0.4055" iyz="0" izz="0.4613"/>
    </inertial>
    <visual>
      <origin xyz="0 -0.49 0.47" rpy="0 0 0"/>
      <geometry><box size="0.03 0.96 0.90"/></geometry>
      <material name="door_wood"><color rgba="0.62 0.46 0.30 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 -0.49 0.47" rpy="0 0 0"/>
      <geometry><box size="0.03 0.96 0.90"/></geometry>
    </collision>
  </link>
  <joint name="door_hinge" type="revolute">
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <parent link="door_frame"/>
    <child link="door_leaf"/>
    <axis xyz="0 0 1"/>
    <limit lower="0.0" upper="1.75" effort="0" velocity="3.0"/>
    <dynamics damping="1.0" friction="0.2"/>
  </joint>
  <!-- Knob: a spindle through the leaf 0.10 m from its free edge, 0.58 m above
       the floor, with a rose and a 56 mm knob on each face. -->
  <link name="door_knob">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.3"/>
      <inertia ixx="0.0002" ixy="0" ixz="0" iyy="0.0004" iyz="0" izz="0.0004"/>
    </inertial>
    <visual>
      <origin xyz="0.02 0 0" rpy="0 1.5707963 0"/>
      <geometry><cylinder radius="0.03" length="0.01"/></geometry>
      <material name="brass"><color rgba="0.78 0.62 0.30 1"/></material>
    </visual>
    <visual>
      <origin xyz="0.035 0 0" rpy="0 1.5707963 0"/>
      <geometry><cylinder radius="0.011" length="0.03"/></geometry>
      <material name="brass"><color rgba="0.78 0.62 0.30 1"/></material>
    </visual>
    <visual>
      <origin xyz="0.065 0 0" rpy="0 0 0"/>
      <geometry><sphere radius="0.028"/></geometry>
      <material name="brass"><color rgba="0.85 0.70 0.36 1"/></material>
    </visual>
    <collision>
      <origin xyz="0.065 0 0" rpy="0 0 0"/>
      <geometry><sphere radius="0.028"/></geometry>
    </collision>
    <collision>
      <origin xyz="0.035 0 0" rpy="0 1.5707963 0"/>
      <geometry><cylinder radius="0.011" length="0.03"/></geometry>
    </collision>
    <visual>
      <origin xyz="-0.02 0 0" rpy="0 1.5707963 0"/>
      <geometry><cylinder radius="0.03" length="0.01"/></geometry>
      <material name="brass"><color rgba="0.78 0.62 0.30 1"/></material>
    </visual>
    <visual>
      <origin xyz="-0.035 0 0" rpy="0 1.5707963 0"/>
      <geometry><cylinder radius="0.011" length="0.03"/></geometry>
      <material name="brass"><color rgba="0.78 0.62 0.30 1"/></material>
    </visual>
    <visual>
      <origin xyz="-0.065 0 0" rpy="0 0 0"/>
      <geometry><sphere radius="0.028"/></geometry>
      <material name="brass"><color rgba="0.85 0.70 0.36 1"/></material>
    </visual>
    <collision>
      <origin xyz="-0.065 0 0" rpy="0 0 0"/>
      <geometry><sphere radius="0.028"/></geometry>
    </collision>
    <collision>
      <origin xyz="-0.035 0 0" rpy="0 1.5707963 0"/>
      <geometry><cylinder radius="0.011" length="0.03"/></geometry>
    </collision>
  </link>
  <joint name="door_knob_joint" type="revolute">
    <origin xyz="0 -0.87 0.58" rpy="0 0 0"/>
    <parent link="door_leaf"/>
    <child link="door_knob"/>
    <axis xyz="1 0 0"/>
    <limit lower="-1.2" upper="1.2" effort="0" velocity="6.0"/>
    <dynamics damping="0.02" friction="0.02"/>
  </joint>
</robot>
