+    /// Sets diagonal generalized armature for one coordinate (kg m² for angular DOFs).
+    ///
+    /// Returns false for an invalid coordinate or non-finite/negative inertia.
+    /// This changes generalized inertia only, not link spatial mass properties.
+    pub fn set_armature(&mut self, dof: usize, inertia: Real) -> bool {
+        if dof >= self.armature.len() || !inertia.is_finite() || inertia < 0.0 {
+            return false;
+        }
+        self.armature[dof] = inertia;
+        true
     }
 
