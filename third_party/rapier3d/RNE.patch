+#[cfg(test)]
+mod rne_armature_tests {
+    use super::*;
+    use crate::dynamics::{RevoluteJointBuilder, RigidBodyBuilder};
+
+    fn hinge() -> MultibodyJoint {
+        MultibodyJoint::new(RevoluteJointBuilder::new(Vector::z_axis()).build().into(), false)
+    }
+
+    #[test]
+    fn armature_survives_append_split_and_root_type_changes() {
+        let mut bodies = RigidBodySet::new();
+        let root = bodies.insert(RigidBodyBuilder::dynamic().build());
+        let first = bodies.insert(RigidBodyBuilder::dynamic().build());
+        let second = bodies.insert(RigidBodyBuilder::dynamic().build());
+        let mut left = Multibody::with_root(root, false);
+        left.add_link(Some(0), hinge(), first);
+        assert!(left.set_armature(SPATIAL_DIM, 0.01));
+        let mut right = Multibody::with_root(second, false);
+        let third = bodies.insert(RigidBodyBuilder::dynamic().build());
+        right.add_link(Some(0), hinge(), third);
+        assert!(right.set_armature(SPATIAL_DIM, 0.03));
+        left.append(right, 1, hinge());
+        assert_eq!(&left.armature.as_slice()[SPATIAL_DIM..], &[0.01, 0.0, 0.03]);
+        bodies[root].set_body_type(RigidBodyType::Fixed, false);
+        left.update_root_type(&bodies, true);
+        assert_eq!(left.armature.as_slice(), &[0.01, 0.0, 0.03]);
+        bodies[root].set_body_type(RigidBodyType::Dynamic, false);
+        left.update_root_type(&bodies, true);
+        assert_eq!(&left.armature.as_slice()[SPATIAL_DIM..], &[0.01, 0.0, 0.03]);
+        let split = left.remove_link(2, true);
+        assert_eq!(split.len(), 2);
+        assert_eq!(split[0].armature.as_slice(), &[0.01]);
+        assert_eq!(split[1].armature.as_slice(), &[0.03]);
+    }
+
+    #[test]
+    fn free_root_com_coordinates_preserve_pose_and_type_transitions() {
+        for offset in [0.0, 0.2] {
+            for read_pose in [false, true] {
+                let mut bodies = RigidBodySet::new();
+                let root = bodies.insert(RigidBodyBuilder::dynamic().build());
+                let local_com = Point::new(offset, -offset, 0.0);
+                bodies[root].mprops.local_mprops.local_com = local_com;
+                let mut mb = Multibody::with_root(root, false);
+                mb.forward_kinematics(&bodies, true);
+                assert!(mb.links[0].local_to_world.translation.vector.norm() < 1.0e-6);
+                mb.velocities[0] = 0.3;
+                mb.velocities[5] = 10.0;
+                mb.integrate(0.1);
+                mb.forward_kinematics(&bodies, false);
+                let actual_com = mb.links[0].local_to_world * local_com;
+                assert!((actual_com - (local_com + Vector::new(0.03, 0.0, 0.0))).norm() < 1.0e-6);
+                mb.update_rigid_bodies(&mut bodies, true);
+                let pose = mb.links[0].local_to_world;
+                for kind in [RigidBodyType::Fixed, RigidBodyType::Dynamic] {
+                    bodies[root].set_body_type(kind, false);
+                    mb.forward_kinematics(&bodies, read_pose);
+                    assert!((mb.links[0].local_to_world.translation.vector - pose.translation.vector).norm() < 1.0e-6);
+                    assert!(mb.links[0].local_to_world.rotation.angle_to(&pose.rotation) < 1.0e-6);
+                }
+                // Changing the COM convention must not teleport the body.
+                bodies[root].mprops.local_mprops.local_com = Point::new(0.1, 0.2, -0.1);
+                mb.forward_kinematics(&bodies, read_pose);
+                assert!((mb.links[0].local_to_world.translation.vector - pose.translation.vector).norm() < 1.0e-6);
+            }
+        }
+    }
+
+    #[test]
+    fn armature_setter_rejects_invalid_values_without_mutation() {
+        let mut mb = Multibody::new();
+        let mut bodies = RigidBodySet::new();
+        let root = bodies.insert(RigidBodyBuilder::fixed().build());
+        mb.add_link(None, hinge(), root);
+        assert!(mb.set_armature(0, 0.01));
+        for value in [-1.0, Real::NAN, Real::INFINITY] {
+            assert!(!mb.set_armature(0, value));
+        }
+        assert!(!mb.set_armature(1, 0.0));
+        assert_eq!(mb.armature.as_slice(), &[0.01]);
+    }
